// generator and datsource block...
generator client {
  provider = "prisma-client"
  output = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// Defining enum type for fields...

enum NetworkEnvironment {
  MAINNET
  TESTNET
}

enum NetworkStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REVERTED
}

enum TransactionType {
  TRANSFER
  PAYMENT
  REFUND
  SWAP
  DEPOSIT
  WITHDRAWAL
}

enum InvoiceType {
  PENDING
  PAID
  PARTIAL
  OVERPAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum WalletStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum WalletRoles {
  DEPOSIT
  PAYOUT
  TREASURY
  HOT
  COLD
}

enum NonceUses {
  WALLET_AUTHENTICATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum NonceStatus {
  UNUSED
  USED
  EXPIRED
  INVALID
}

enum AuthMethods {
  WALLET
  EMAIL
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  PARTIAL
  MISMATCHED
  EXCEPTION
}

enum WorkspaceStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum WorkspaceMemberRoles {
  OWNER
  ADMIN
  FINANCER
  VIEWER
  GUEST
}

enum MemberStatus {
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
  REMOVED
}

enum AssetType {
  NATIVE
  TOKEN
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum AuditAction {
  // Authentication & Access
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGED
  PASSWORD_RESET
  MFA_ENABLED
  MFA_DISABLED

  // Workspace
  WORKSPACE_CREATED
  WORKSPACE_UPDATED
  WORKSPACE_DELETED
  WORKSPACE_SUSPENDED
  WORKSPACE_REACTIVATED

  // Workspace Members
  MEMBER_INVITED
  MEMBER_INVITATION_ACCEPTED
  MEMBER_INVITATION_REVOKED
  MEMBER_ROLE_UPDATED
  MEMBER_SUSPENDED
  MEMBER_REACTIVATED
  MEMBER_REMOVED

  // Wallets
  WALLET_CREATED
  WALLET_UPDATED
  WALLET_DEACTIVATED
  WALLET_ARCHIVED

  // Networks & Assets
  NETWORK_CREATED
  NETWORK_UPDATED
  NETWORK_STATUS_CHANGED
  ASSET_CREATED
  ASSET_UPDATED
  ASSET_STATUS_CHANGED

  // Transactions & Payments
  PAYMENT_CREATED
  PAYMENT_UPDATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  PAYMENT_EXPIRED
  TRANSACTION_DETECTED
  TRANSACTION_CONFIRMED
  TRANSACTION_FAILED
  RECONCILIATION_STARTED
  RECONCILIATION_COMPLETED
  RECONCILIATION_FAILED
  DISCREPANCY_DETECTED
  DISCREPANCY_RESOLVED

  // Payouts
  PAYOUT_CREATED
  PAYOUT_APPROVED
  PAYOUT_REJECTED
  PAYOUT_PROCESSED
  PAYOUT_FAILED
  PAYOUT_CANCELLED

  // Security & Configuration
  PERMISSION_DENIED
  SETTINGS_UPDATED
  SECURITY_ALERT
  SUSPICIOUS_ACTIVITY_DETECTED

  // Administrative
  DATA_EXPORTED
  MANUAL_ADJUSTMENT
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum SearchEntityType {
  USER
  WALLET
  INVOICE
  WORKSPACE
  AUDITLOGS
  TRANSACTION
  RECONCILIATION
  SEMANTIC
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Transactions {
  recordId String @id @default("txn_`${uuid()}`")

  // Blockchain details
  networkId String
  network   Networks? @relation(fields: [networkId], references: [recordId])

  txHash      String
  blockNumber BigInt?
  blockHash   String?

  // Wallet details
  from String
  to   String

  // Token details
  tokenAddress  String?
  tokenSymbol   String
  tokenDecimals Int

  // Financial details
  amount   String
  gasUsed  String?
  gasPrice String?

  // Transaction metadata
  type   TransactionType   @default(TRANSFER)
  status TransactionStatus @default(PENDING)

  embedding Unsupported("vector(768)")?

  // Timestamps
  blockTimestamp DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([txHash])
  @@index([from])
  @@index([to])
  @@index([status])
  @@index([blockNumber])
}

model Invoices {
  recordId String @id @default("inv_`${uuid()}`")

  from String
  to   String

  expectedAmount String

  workspaceId String
  workspace   Workspaces? @relation(fields: [workspaceId], references: [recordId])
  networkId   String
  network     Networks?   @relation(fields: [networkId], references: [recordId])

  tokenAddress  String?
  tokenSymbol   String
  tokenDecimals Int

  status InvoiceType @default(PENDING)
  expiry DateTime

  embedding Unsupported("vector(768)")?

  reconciliation Reconciliations[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([from])
  @@index([to])
  @@index([status])
}

model Networks {
  recordId    String             @id @default("net_`${uuid()}`")
  name        String
  slug        String             @unique
  chainId     Int
  environment NetworkEnvironment
  status      NetworkStatus      @default(ACTIVE)

  currencyName     String
  currencySymbol   String
  currencyDecimals Int

  wallets      Wallets[]
  transactions Transactions[]
  Invoices     Invoices[]
  assets       Assets[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chainId, environment])
}

model Wallets {
  recordId String @id @default("wal_`${uuid()}`")

  workspaceId String
  address     String
  status      WalletStatus @default(ACTIVE)

  label      String
  walletRole WalletRoles @default(DEPOSIT)

  networkId String
  network   Networks? @relation(fields: [networkId], references: [recordId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, address, networkId])
}

model Nonces {
  recordId String @id @default("non_`${uuid()}`")

  nonce     String
  usedFor   NonceUses   @default(WALLET_AUTHENTICATION)
  walletAdd String?
  status    NonceStatus @default(UNUSED)

  expiry DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiry])
}

model User {
  recordId      String @id @default("usr_`${uuid()}`")

  username      String @unique
  email         String @unique
  profilepic    String @unique
  profilebanner String @unique

  authMethod AuthMethods @default(EMAIL)

  members       WSmember[]
  auditlogs     Auditlogs[]
  searches      Searchs[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, username])
}

model Reconciliations {
  recordId String @id @default("rec_`${uuid()}`")

  invoiceId String
  invoice   Invoices? @relation(fields: [invoiceId], references: [recordId])

  expectedAmount String
  recievedAmount String

  difference String @default("0")

  status ReconciliationStatus @default(PENDING)

  resolved Boolean @default(false)

  embedding Unsupported("vector(768)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([difference])
}

model Workspaces {
  recordId String @id @default("wsp_`${uuid()}`")

  name String @unique
  slug String

  status WorkspaceStatus @default(ACTIVE)

  embedding Unsupported("vector(1536)")?

  members   WSmember[]
  invoices  Invoices[]
  auditlogs Auditlogs[]
  searches  Searchs[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model WSmember {
  recordId String @id @default("mem_`${uuid()}`")

  workspaceId String
  workspace   Workspaces? @relation(fields: [workspaceId], references: [recordId])

  userId String
  user   User?  @relation(fields: [userId], references: [recordId])

  role WorkspaceMemberRoles @default(VIEWER)

  status MemberStatus @default(INACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
}

model Assets {
  recordId String @id @default("ass_`${uuid()}`")

  name   String
  symbol String
  slug   String

  type   AssetType
  status AssetStatus @default(ACTIVE)

  decimals Int

  contractAdd String?

  networkId String
  network   Networks @relation(fields: [networkId], references: [recordId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([networkId, slug])
  @@index([networkId, status])
  @@index([symbol])
}

model Auditlogs {
  id      String       @id @default("aud_`${uuid()}`")
  action  AuditAction
  outcome AuditOutcome

  actorId     String?
  actor       User?       @relation(fields: [actorId], references: [recordId])
  workspaceId String?
  workspace   Workspaces? @relation(fields: [workspaceId], references: [recordId])

  targetType String?
  targetId   String?

  ipAddress String?
  userAgent String?

  metadata  Json?
  embedding Unsupported("vector(768)")?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Searchs {
  recordId String @id @default("scr_`${uuid()}`")

  userId      String?
  user        User?       @relation(fields: [userId], references: [recordId])
  workspaceId String?
  workspace   Workspaces? @relation(fields: [workspaceId], references: [recordId])

  entityId   String
  entityType SearchEntityType

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, entityType])
  @@index([entityType, entityId])
}


model SubscriptionPlan {
  recordId             String          @id @default(uuid())

  name           String
  description    String?

  // Pricing in smallest currency unit...
  price          Int
  currency       String          @default("USD")

  billingInterval BillingInterval

  // Plan features
  features       Json?

  // Payment provider
  providerPriceId String?        @unique

  // Availability
  isActive       Boolean         @default(true)

  subscriptions  Subscription[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}
model Subscription {
  recordId                     String       @id @default(uuid())

  // User relationship
  userId                 String
  user                   User               @relation(fields:[userId], references: [recordId])

  // Plan details
  planId                 String
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [recordId])

  // Payment provider
  provider               String             // STRIPE, RAZORPAY
  providerSubscriptionId String?            @unique
  providerCustomerId     String?

  // Subscription details
  status                 SubscriptionStatus @default(INCOMPLETE)
  billingInterval        BillingInterval

  // Billing cycle
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?

  // Trial
  trialStart             DateTime?
  trialEnd               DateTime?

  // Cancellation
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?

  // Payment records
  payments               SubscriptionPayment[]

  // Timestamps
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}


model SubscriptionPayment {
  recordId                String        @id @default(cuid())

  subscriptionId    String
  subscription      Subscription  @relation(fields: [subscriptionId], references: [recordId])

  // Payment provider
  providerPaymentId String?       @unique
  providerInvoiceId String?       @unique

  // Payment details
  amount            Int
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)

  // Billing period
  periodStart       DateTime?
  periodEnd         DateTime?

  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  @@index([subscriptionId])
  @@index([status])
}